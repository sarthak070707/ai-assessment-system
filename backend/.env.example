# Copy to .env and edit as needed.
DATABASE_URL=sqlite:///./assessment.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/assessment

JWT_SECRET=replace-me-with-at-least-32-random-bytes
JWT_EXPIRE_MINUTES=480

# Descriptive-answer grading
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REVIEW_LOWER=0.35
REVIEW_UPPER=0.65

# Code sandbox
CODE_TIMEOUT_SECONDS=5
CODE_MEMORY_MB=256

# Restrict candidate exam access to named networks (comma-separated CIDR).
# Blank = unrestricted, which is correct for local development and demos.
# Example: EXAM_ALLOWED_NETWORKS=10.0.0.0/8,192.168.1.0/24
EXAM_ALLOWED_NETWORKS=

# How long a freshly issued exam code stays valid.
ACCESS_CODE_VALID_HOURS=6

# Optional: LLM-assisted question extraction from uploaded papers.
# Free key, no card required: https://console.groq.com
# Without it the importer falls back to pattern matching automatically.
GROQ_API_KEY=
# Groq deprecated the Llama chat models. Check console.groq.com/docs/models
# for what is currently available before changing this.
GROQ_MODEL=openai/gpt-oss-120b

# Deployment only. The frontend's origin, comma separated, no trailing slash.
# Unset in development, where it defaults to the local Vite server.
#   ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=

# Set to "production" on a deployed host. Doing so makes JWT_SECRET mandatory:
# the service refuses to start without one rather than falling back to the
# placeholder published in this repository.
ENVIRONMENT=development
