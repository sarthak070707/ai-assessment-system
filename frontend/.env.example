# Where the API lives. Leave blank for local development: Vite proxies /api to
# the backend on port 8000, so nothing is needed.
#
# For a deployed build, set this to the backend's origin with no trailing slash:
#   VITE_API_URL=https://your-service.onrender.com
#
# Vite inlines this at build time, not at runtime, so changing it on the host
# requires a redeploy.
VITE_API_URL=
